# Copy this file to .env and fill in your key.
# Free key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides -- defaults work out of the box with Groq's free tier.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- Registered Indian agency feeds (NOT ACTIVATED) ---
# These connectors in data_connectors/isro_sources.py stay inactive until
# real keys are obtained from each agency. Nothing calls them by default.
# MOSDAC_API_KEY=      # https://mosdac.gov.in  (chlorophyll, SST - ISRO)
# INCOIS_API_KEY=      # https://oos.incois.org (ocean state forecast, tides)
# IMD_API_KEY=         # api.imd.gov.in (gated; only used as secondary fallback)

# NOTE: cyclone/warning checks need NO key -- they use IMD's official
# keyless CAP alerts feed via data_connectors/imd_cap.py.

# --- SAR-Based Dark Vessel Detection (Innovation #3) ---
# Provider selection: auto (Bhoonidhi if configured else demo) | demo | bhoonidhi
# ORCA_SAR_PROVIDER=auto
# Boundary/matching thresholds (all env-overridable, not hard-coded)
# ORCA_SAR_BOUNDARY_RADIUS_KM=10
# ORCA_SAR_MATCH_RADIUS_KM=2.0
# ORCA_SAR_MATCH_WINDOW_MINUTES=60
# ORCA_SAR_MIN_CONFIDENCE=0.50
# ORCA_SAR_HIGH_CONFIDENCE=0.80
# ORCA_SAR_HIGH_ALERT_DISTANCE_KM=5
# ORCA_SAR_STALE_MINUTES=120
# ORCA_SAR_CACHE_TTL_S=600
#
# --- Satellite-Model Wind Divergence Flag (Innovation #4) ---
# Real provider: ISRO Oceansat-3 OSCAT-3 via MOSDAC (SCATSAT-1 ended 2021). NOT ACTIVATED until MOSDAC_API_KEY is set.
# MOSDAC_API_KEY=your_mosdac_key
# Thresholds (env-overridable, no magic numbers):
# ORCA_WIND_DIVERGENCE_MODERATE_KMH=9
# ORCA_WIND_DIVERGENCE_HIGH_KMH=15
# ORCA_WIND_DIVERGENCE_MODERATE_PCT=25
# ORCA_WIND_DIVERGENCE_HIGH_PCT=50
# ORCA_WIND_DIRECTION_MODERATE_DEG=45
# ORCA_WIND_MAX_SPATIAL_KM=50
# ORCA_WIND_MAX_AGE_MIN=180
# ORCA_WIND_HIGH_DIVERGENCE_PENALTY=0.15
# ORCA_SATWIND_TTL_S=1800
#
# Demo scenarios (no credentials needed): match / moderate / high_divergence via wind_demo_scenario param

# --- Bhoonidhi EO (ISRO/NRSC) — official SAR data ---
# Bhoonidhi provides SAR collections including NISAR SAR and Sentinel-1 SAR.
# Do NOT hard-code RISAT assumption — use the actual currently accessible collection.
# Register at https://bhoonidhi.nrsc.gov.in and set credentials:
# BHOONIDHI_API_KEY=your_key_here
# # or username/password pair:
# BHOONIDHI_USERNAME=your_username
# BHOONIDHI_PASSWORD=your_password
# BHOONIDHI_BASE_URL=https://bhoonidhi.nrsc.gov.in/bhoonidhi
# BHOONIDHI_DATASET=NISAR_SAR  # or Sentinel-1_SAR, SAR_GENERIC (auto if unset)
